{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "t08-passkey-myspace",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "t08-passkey-db",
      "database_id": "dad8675a-4d38-4e9f-a158-e9917b9e70ab"
    }
  ]
}
