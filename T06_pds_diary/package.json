{
  "name": "t06-pds-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create t06-pds-diary-db",
    "db:migrate:local": "wrangler d1 migrations apply t06-pds-diary-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply t06-pds-diary-db --remote",
    "db:seed:local": "wrangler d1 execute t06-pds-diary-db --local --file=./scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute t06-pds-diary-db --remote --file=./scripts/seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.143.0"
  }
}
